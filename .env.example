# Supabase Configuration
# Obtain these values from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend Server Configuration
PORT=8000
GEMINI_MODEL=gemini-2.5-flash
# Optional server-side fallback Gemini key (per-request key supplied by frontend is preferred)
GEMINI_API_KEY=AIzaSy...

# CORS Allowed Origins for Backend (comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,https://your-app.vercel.app

# Frontend Config (frontend/config.js)
# Set APP_CONFIG values in frontend/config.js or window.APP_CONFIG
